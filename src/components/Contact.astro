---
import { profile } from "../data/profile";
---

<section id="contact" class="section section--accent">
  <div class="container contact-panel">
    <div class="contact-panel__copy">
      <p class="eyebrow">Liên hệ</p>
      <h2 class="section-title__heading">Hãy cùng xây một sản phẩm rõ ràng, đẹp và đủ bền để scale tiếp.</h2>
      <p>
        Nếu bạn đang cần một người làm product-facing frontend, backoffice hoặc
        các bài toán có yếu tố CV & AI, mình sẵn sàng trao đổi.
      </p>
    </div>

    <div class="contact-panel__actions">
      <a class="button button--light" href={`mailto:${profile.email}`}>
        {profile.email}
      </a>

      <div class="social-links" aria-label="Mạng xã hội">
        {profile.socials.map((social) => (
          <a href={social.url} target="_blank" rel="noopener noreferrer">
            {social.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
