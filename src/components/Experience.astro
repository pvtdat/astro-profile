---
import { experiences } from "../data/experience";
---

<section id="experience" class="section section--muted">
  <div class="container">
    <p class="eyebrow">Kinh nghiệm</p>
    <h2 class="section-title__heading">Quá trình làm việc</h2>

    <div class="timeline">
      {
        experiences.map((experience) => (
          <article class="timeline__item">
            <div class="timeline__meta font-inter">
              <p>{experience.period}</p>
            </div>

            <div class="timeline__content">
              <h3>{experience.role}</h3>
              <p class="timeline__company">{experience.company}</p>
              <p>{experience.description}</p>

              <ul>
                {experience.achievements.map((achievement) => (
                  <li>
                    {achievement
                      .split("**")
                      .map((part, index) =>
                        index % 2 === 1 ? <strong>{part}</strong> : part,
                      )}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
