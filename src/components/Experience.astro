---
import { experiences } from "../data/experience";
---

<section id="experience" class="section section--muted">
  <div class="container">
    <p class="eyebrow">Kinh nghiệm &amp; học vấn</p>
    <h2 class="section-title__heading">Quá trình học tập và làm việc</h2>

    <div class="timeline">
      {
        experiences.map((experience) => (
          <article class="timeline__item">
            <div class="timeline__meta font-inter">
              <div class="timeline__company-mark">
                <img
                  src={experience.logo.src}
                  alt={experience.logo.alt}
                  width="72"
                  height="72"
                  loading="lazy"
                />
              </div>
              <p>{experience.period}</p>
            </div>

            <div class="timeline__content">
              <div class="timeline__headline">
                <h3>
                  {experience.kind === "education"
                    ? experience.degree
                    : experience.role}
                </h3>
                <p class="timeline__company">
                  {experience.kind === "education"
                    ? experience.school
                    : experience.company}
                </p>
                {experience.kind === "education" && (
                  <p class="timeline__gpa">GPA {experience.gpa}/10</p>
                )}
              </div>
              <p>{experience.description}</p>

              <ul>
                {experience.achievements.map((achievement) => (
                  <li>
                    {achievement
                      .split("**")
                      .map((part, index) =>
                        index % 2 === 1 ? <strong>{part}</strong> : part,
                      )}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
