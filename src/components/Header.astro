---
import ThemeToggle from "./ThemeToggle.astro";

const base = import.meta.env.BASE_URL;

const navigationItems = [
  { label: "Giới thiệu", href: "#about" },
  { label: "Kỹ năng", href: "#skills" },
  { label: "Kinh nghiệm", href: "#experience" },
  { label: "Dự án", href: "#projects" },
];
---

<header class="site-header">
  <nav class="container navigation" aria-label="Điều hướng chính">
    <a class="logo" href={base} aria-label="Về trang chủ">
      <span class="logo__mark">DP</span>
      <span class="logo__text">
        <strong>Dat Pham</strong>
        <span>Software Engineer</span>
      </span>
    </a>

    <div class="navigation__cluster">
      <ul class="navigation__list">
        {
          navigationItems.map((item) => (
            <li
              class="navigation__item"
              data-nav-item
              data-section={item.href.slice(1)}
            >
              <a href={`${base}${item.href}`}>
                <span>{item.label}</span>
                <span class="navigation__highlight" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>

      <ThemeToggle id="header-theme-toggle" />

      <a class="button button--secondary navigation__cta" href="#contact">
        Liên hệ
      </a>

      <button
        id="mobile-menu-toggle"
        class="navigation__toggle"
        type="button"
        aria-label="Mở menu điều hướng"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="navigation__toggle-icon">
          <span class="navigation__toggle-bar"></span>
          <span class="navigation__toggle-bar"></span>
          <span class="navigation__toggle-bar"></span>
        </span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu-backdrop"
    class="mobile-menu-backdrop"
    aria-hidden="true"
  >
  </div>
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <ul class="mobile-menu__list">
      {
        navigationItems.map((item) => (
          <li
            class="mobile-menu__item"
            data-mobile-nav-item
            data-section={item.href.slice(1)}
          >
            <a href={`${base}${item.href}`}>
              <span>{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mobile-menu__actions">
      <ThemeToggle id="mobile-menu-theme-toggle" />
      <a
        class="button button--primary mobile-menu__cta"
        href="#contact"
        data-mobile-close
      >
        Liên hệ
      </a>
    </div>
  </div>
</header>

<script>
  const navItems = Array.from(document.querySelectorAll("[data-nav-item]"));
  const mobileNavItems = Array.from(
    document.querySelectorAll("[data-mobile-nav-item]"),
  );
  const mobileToggleBtn = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileBackdrop = document.getElementById("mobile-menu-backdrop");
  const mobileCloseTriggers = document.querySelectorAll("[data-mobile-close]");

  let isMobileMenuOpen = false;

  const toggleMobileMenu = (open?: boolean) => {
    isMobileMenuOpen = open ?? !isMobileMenuOpen;

    if (mobileToggleBtn) {
      mobileToggleBtn.classList.toggle("is-open", isMobileMenuOpen);
      mobileToggleBtn.setAttribute("aria-expanded", String(isMobileMenuOpen));
      mobileToggleBtn.setAttribute(
        "aria-label",
        isMobileMenuOpen ? "Đóng menu điều hướng" : "Mở menu điều hướng",
      );
    }

    if (mobileMenu) {
      mobileMenu.classList.toggle("is-open", isMobileMenuOpen);
      mobileMenu.setAttribute("aria-hidden", String(!isMobileMenuOpen));
    }

    if (mobileBackdrop) {
      mobileBackdrop.classList.toggle("is-open", isMobileMenuOpen);
      mobileBackdrop.setAttribute("aria-hidden", String(!isMobileMenuOpen));
    }

    document.body.style.overflow = isMobileMenuOpen ? "hidden" : "";
  };

  if (mobileToggleBtn) {
    mobileToggleBtn.addEventListener("click", () => toggleMobileMenu());
  }

  if (mobileBackdrop) {
    mobileBackdrop.addEventListener("click", () => toggleMobileMenu(false));
  }

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isMobileMenuOpen) {
      toggleMobileMenu(false);
    }
  });

  mobileCloseTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => toggleMobileMenu(false));
  });

  if (navItems.length > 0 || mobileNavItems.length > 0) {
    let currentActiveId = window.location.hash.replace("#", "");
    const headerOffset = 96;
    const targetLineOffset = 24;
    const contactSectionId = "contact";
    const footerElement = document.querySelector("footer.site-footer");

    if (!currentActiveId && navItems.length > 0) {
      currentActiveId = navItems[0]?.getAttribute("data-section") ?? "";
    }

    const applyActiveState = () => {
      navItems.forEach((item) => {
        const link = item.querySelector("a");
        const isActive = item.getAttribute("data-section") === currentActiveId;

        item.classList.toggle("is-active", isActive);
        if (link) {
          if (isActive) {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        }
      });

      mobileNavItems.forEach((item) => {
        const isActive = item.getAttribute("data-section") === currentActiveId;
        item.classList.toggle("is-active", isActive);
      });
    };

    applyActiveState();

    const updateActiveSectionByViewport = () => {
      if (navItems.length === 0) return;

      if (footerElement) {
        const footerRect = footerElement.getBoundingClientRect();
        const footerVisible =
          footerRect.top <= window.innerHeight - headerOffset;
        const nearPageBottom =
          window.scrollY + window.innerHeight >=
          document.documentElement.scrollHeight - 2;

        if (footerVisible || nearPageBottom) {
          if (currentActiveId !== contactSectionId) {
            currentActiveId = contactSectionId;
            applyActiveState();
          }
          return;
        }
      }

      const targetLine = window.scrollY + headerOffset + targetLineOffset;
      let nearestId = "";
      let foundPastSection = false;
      let nearestDistance = Number.POSITIVE_INFINITY;

      navItems.forEach((item) => {
        const sectionId = item.getAttribute("data-section");
        if (!sectionId) return;
        const sectionElement = document.getElementById(sectionId);
        if (!sectionElement) return;

        const sectionTop = sectionElement.offsetTop;
        const isPastTargetLine = sectionTop <= targetLine;

        if (!isPastTargetLine) return;

        foundPastSection = true;

        const distance = Math.abs(targetLine - sectionTop);
        if (distance < nearestDistance) {
          nearestId = sectionId;
          nearestDistance = distance;
        }
      });

      if (!foundPastSection) {
        const firstId = navItems[0]?.getAttribute("data-section") ?? "";
        if (firstId && firstId !== currentActiveId) {
          currentActiveId = firstId;
          applyActiveState();
        }
        return;
      }

      if (nearestId && nearestId !== currentActiveId) {
        currentActiveId = nearestId;
        applyActiveState();
      }
    };

    const handleNavClick = (item: Element, event: Event) => {
      const sectionId = item.getAttribute("data-section");
      if (!sectionId) return;
      const sectionElement = document.getElementById(sectionId);
      if (!sectionElement) return;

      event.preventDefault();

      if (isMobileMenuOpen) {
        toggleMobileMenu(false);
      }

      currentActiveId = sectionId;
      applyActiveState();

      const targetY = sectionElement.offsetTop - headerOffset;
      window.scrollTo({
        top: Math.max(0, targetY),
        behavior: "smooth",
      });

      history.replaceState(null, "", `#${sectionId}`);
    };

    navItems.forEach((item) => {
      const link = item.querySelector("a");
      if (!link) return;
      link.addEventListener("click", (e) => handleNavClick(item, e));
    });

    mobileNavItems.forEach((item) => {
      const link = item.querySelector("a");
      if (!link) return;
      link.addEventListener("click", (e) => handleNavClick(item, e));
    });

    window.addEventListener("scroll", updateActiveSectionByViewport, {
      passive: true,
    });
    window.addEventListener("resize", updateActiveSectionByViewport);

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        updateActiveSectionByViewport();
      },
      {
        rootMargin: "-20% 0px -65% 0px",
        threshold: [0, 0.01, 0.05],
      },
    );

    navItems.forEach((item) => {
      const sectionId = item.getAttribute("data-section");
      if (!sectionId) return;
      const sectionElement = document.getElementById(sectionId);
      if (!sectionElement) return;
      observer.observe(sectionElement);
    });

    updateActiveSectionByViewport();
  }
</script>
