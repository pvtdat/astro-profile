---
import { skillGroups } from "../data/skills";
---

<section id="skills" class="section">
  <div class="container">
    <p class="eyebrow">Kỹ năng</p>
    <h2>Công nghệ thường sử dụng</h2>

    <div class="card-grid card-grid--three">
      {
        skillGroups.map((group) => (
          <article class="card">
            <h3>{group.title}</h3>
            <ul class="tag-list" aria-label={`Kỹ năng ${group.title}`}>
              {group.items.map((item) => (
                <li
                  class:list={{
                    "tag-list__item--core": group.coreSkills?.includes(item),
                  }}
                >
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
