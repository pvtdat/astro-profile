---
import BaseLayout from "../layouts/BaseLayout.astro";
import { certificates } from "../data/certificates";
import { profile } from "../data/profile";

const base = import.meta.env.BASE_URL;
const assetPath = (path: string) => `${base}${path}`;
const currentYear = new Date().getFullYear();
const goatcounterEndpoint =
  import.meta.env.PUBLIC_GOATCOUNTER_ENDPOINT ??
  "https://datpham.goatcounter.com/count";

const sortedCertificates = [...certificates].sort((a, b) => {
  const yearA = Number.parseInt(a.issuedAt, 10) || 0;
  const yearB = Number.parseInt(b.issuedAt, 10) || 0;
  return yearB - yearA;
});

const featuredCertificate = sortedCertificates[0];
const latestIssuedYear =
  sortedCertificates.reduce((latest, certificate) => {
    const issuedYear = Number.parseInt(certificate.issuedAt, 10);
    return Number.isNaN(issuedYear) ? latest : Math.max(latest, issuedYear);
  }, 0) || currentYear;
const uniqueIssuers = new Set(certificates.map((certificate) => certificate.issuer)).size;
---

<BaseLayout
  title={`Certificates | ${profile.name}`}
  description={`Các chứng chỉ và thành tựu chuyên môn của ${profile.name}.`}
>
  <header class="site-header certificate-header">
    <nav class="container navigation" aria-label="Điều hướng chính">
      <a class="logo" href={base} aria-label="Về trang chủ">
        <span class="logo__mark">DP</span>
        <span class="logo__text">
          <strong>Dat Pham</strong>
          <span>Software Engineer</span>
        </span>
      </a>

      <div class="navigation__cluster">
        <ul class="navigation__list">
          <li class="navigation__item is-active">
            <a href="#certificate-top" aria-current="page">
              <span>Chứng chỉ</span>
              <span class="navigation__highlight" aria-hidden="true" />
            </a>
          </li>
        </ul>

        <a class="button button--secondary navigation__cta" href={base}>
          Về trang chủ
        </a>
      </div>
    </nav>
  </header>

  <main id="certificate-top">
    <section class="certificate-hero container">
      <div class="certificate-hero__content">
        <p class="eyebrow">Learning journey</p>
        <h1>Certificates</h1>
        <p class="certificate-hero__lead">
          Những cột mốc ghi lại quá trình học hỏi, rèn luyện và phát triển chuyên môn của tôi.
        </p>
        <div class="certificate-hero__actions">
          <a class="button button--primary" href="#certificate-gallery">Xem danh sách</a>
          <a class="button button--secondary" href="#featured-certificate">Chứng chỉ nổi bật</a>
        </div>
        <dl class="certificate-hero__metrics" aria-label="Tổng quan chứng chỉ">
          <div class="certificate-metric">
            <dt>{String(certificates.length).padStart(2, "0")}</dt>
            <dd>Chứng chỉ đã hoàn thành</dd>
          </div>
          <div class="certificate-metric">
            <dt>{latestIssuedYear}</dt>
            <dd>Năm cập nhật mới nhất</dd>
          </div>
          <div class="certificate-metric">
            <dt>{uniqueIssuers}</dt>
            <dd>Đơn vị cấp chứng chỉ</dd>
          </div>
        </dl>
        <div
          class="certificate-live-stats"
          data-goatcounter-stats
          data-goatcounter-endpoint={goatcounterEndpoint}
        >
          <div class="certificate-live-stat">
            <span>Unique visitors</span>
            <strong data-goatcounter-unique>--</strong>
          </div>
          <div class="certificate-live-stat">
            <span>Total views</span>
            <strong data-goatcounter-views>--</strong>
          </div>
        </div>
      </div>

      {featuredCertificate && (
        <aside class="certificate-feature" id="featured-certificate">
          <p class="certificate-feature__label">Featured credential</p>
          <button
            class="certificate-feature__preview"
            type="button"
            data-certificate-open
            data-image={assetPath(featuredCertificate.image)}
            data-title={featuredCertificate.title}
            aria-label={`Xem ảnh lớn: ${featuredCertificate.title}`}
          >
            <img
              src={assetPath(featuredCertificate.image)}
              alt={`Chứng chỉ ${featuredCertificate.title} do ${featuredCertificate.issuer} cấp`}
              width="1200"
              height="360"
              loading="eager"
            />
            <span class="certificate-feature__badge font-inter" aria-hidden="true">Xem ảnh</span>
          </button>
          <div class="certificate-feature__body">
            <div class="certificate-feature__meta">
              <span>{featuredCertificate.issuer}</span>
              <span>{featuredCertificate.issuedAt}</span>
            </div>
            <h2 class="font-playfair">{featuredCertificate.title}</h2>
            <p>Mốc học tập tiêu biểu gần nhất trong hành trình của tôi.</p>
            <ul class="tag-list font-inter" aria-label="Kỹ năng nổi bật">
              {featuredCertificate.skills.map((skill) => (
                <li class="tag-list__item--core">{skill}</li>
              ))}
            </ul>
            {featuredCertificate.credentialUrl && (
              <a
                class="certificate-card__credential"
                href={featuredCertificate.credentialUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Xem credential <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </aside>
      )}
    </section>

    <section class="certificate-gallery container" id="certificate-gallery" aria-label="Danh sách chứng chỉ">
      <div class="certificate-gallery__header">
        <div class="section-copy">
          <p class="eyebrow">Selected records</p>
          <h2>Danh sách chứng chỉ</h2>
          <p class="section-intro">
            Mỗi chứng chỉ bên dưới đại diện cho một giai đoạn học tập hoặc một kỹ năng tôi đã chủ động hoàn thành và duy trì.
          </p>
        </div>
        <p class="certificate-gallery__note">
          Tất cả thẻ đều có thể mở ảnh lớn để kiểm tra nội dung rõ hơn.
        </p>
      </div>

      {sortedCertificates.length > 0 ? (
        sortedCertificates.map((certificate, index) => (
          <article
            class:list={[
              "certificate-card",
              index === 0 && "certificate-card--featured",
            ]}
          >
            <button
              class="certificate-card__preview"
              type="button"
              data-certificate-open
              data-image={assetPath(certificate.image)}
              data-title={certificate.title}
              aria-label={`Xem ảnh lớn: ${certificate.title}`}
            >
              <img
                src={assetPath(certificate.image)}
                alt={`Chứng chỉ ${certificate.title} cấp bởi ${certificate.issuer}`}
                width="1200"
                height="360"
                loading={index === 0 ? "eager" : "lazy"}
              />
              <span class="certificate-card__zoom" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-arrow-up-right-icon lucide-arrow-up-right"
                >
                  <path d="M7 7h10v10" />
                  <path d="M7 17 17 7" />
                </svg>
              </span>
            </button>

            <div class="certificate-card__body">
              <div class="certificate-card__meta font-manrope">
                <span>{certificate.issuer}</span>
                <span>{certificate.issuedAt}</span>
              </div>
              <h2 class="font-playfair">{certificate.title}</h2>
              <p class="certificate-card__summary">

                {certificate.summary || "Một chứng chỉ ghi nhận nỗ lực học tập và kết quả thực hành ở mảng này."}
              </p>
              <ul class="tag-list font-inter" aria-label="Kỹ năng">
                {certificate.skills.map((skill) => (
                  <li>{skill}</li>
                ))}
              </ul>
              {certificate.credentialUrl && (
                <a
                  class="certificate-card__credential"
                  href={certificate.credentialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Xem credential <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </article>
        ))
      ) : (
        <div class="certificate-empty">
          <p class="eyebrow">No certificates yet</p>
          <h2>Hiện chưa có chứng chỉ nào để hiển thị.</h2>
        </div>
      )}
    </section>
  </main>

  <dialog class="certificate-lightbox" data-certificate-dialog>
    <div class="certificate-lightbox__bar">
      <p data-certificate-title></p>
      <button
        class="certificate-lightbox__close"
        type="button"
        data-certificate-close
        aria-label="Đóng ảnh chứng chỉ"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-x-icon lucide-x"
        >
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
    </div>
    <img data-certificate-image src="" alt="" />
  </dialog>

  <footer class="site-footer font-manrope">
    <div class="container site-footer__content">
      <p>© {currentYear} {profile.name}. All rights reserved.</p>
      <a href="#certificate-top" class="navigation__back">
        <span>Lên đầu trang</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-arrow-big-up-dash-icon lucide-arrow-big-up-dash"
        >
          <path d="M14 16a1 1 0 0 0 1-1v-2a1 1 0 0 1 1-1h3.293a.707.707 0 0 0 .5-1.207l-6.939-6.939a1.207 1.207 0 0 0-1.708 0l-6.94 6.94a.707.707 0 0 0 .5 1.206H8a1 1 0 0 1 1 1v2a1 1 0 0 0 1 1z" />
          <path d="M9 20h6" />
        </svg>
      </a>
    </div>
  </footer>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>(
      "[data-certificate-dialog]",
    );
    const dialogImage = dialog?.querySelector<HTMLImageElement>(
      "[data-certificate-image]",
    );
    const dialogTitle = dialog?.querySelector<HTMLElement>(
      "[data-certificate-title]",
    );
    const closeButton = dialog?.querySelector<HTMLButtonElement>(
      "[data-certificate-close]",
    );

    document
      .querySelectorAll<HTMLButtonElement>("[data-certificate-open]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          if (!dialog || !dialogImage || !dialogTitle) return;
          const title = button.dataset.title ?? "Certificate";
          dialogImage.src = button.dataset.image ?? "";
          dialogImage.alt = title;
          dialogTitle.textContent = title;
          dialog.showModal();
        });
      });

    closeButton?.addEventListener("click", () => dialog?.close());
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    const statsRoot = document.querySelector<HTMLElement>(
      "[data-goatcounter-stats]",
    );
    const goatcounterEndpoint = statsRoot?.dataset.goatcounterEndpoint;

    if (statsRoot && goatcounterEndpoint) {
      const uniqueEl = statsRoot.querySelector<HTMLElement>(
        "[data-goatcounter-unique]",
      );
      const viewsEl = statsRoot.querySelector<HTMLElement>(
        "[data-goatcounter-views]",
      );

      const resolvePath = () => {
        const goatcounter = (window as any).goatcounter as
          | {
              get_data?: () => { p?: string };
            }
          | undefined;

        return goatcounter?.get_data?.().p ?? window.location.pathname;
      };

      const loadCounter = async (path: string) => {
        const response = await fetch(
          `${goatcounterEndpoint}/counter/${encodeURIComponent(path)}.json`,
        );

        console.log("Fetching GoatCounter data for", path, response);

        if (!response.ok) {
          throw new Error(`Failed to load GoatCounter data for ${path}`);
        }

        return response.json() as Promise<{ count: string }>;
      };

      Promise.all([
        loadCounter("TOTAL"),
        loadCounter(resolvePath()),
      ])
        .then(([total, currentPage]) => {
          if (uniqueEl) uniqueEl.textContent = total.count;
          if (viewsEl) viewsEl.textContent = currentPage.count;
        })
        .catch(() => {
          if (uniqueEl) uniqueEl.textContent = "N/A";
          if (viewsEl) viewsEl.textContent = "N/A";
        });
    }
  </script>
</BaseLayout>
