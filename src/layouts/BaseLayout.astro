---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Personal portfolio built with Astro" } =
  Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url.origin,
);
const faviconPath = `${import.meta.env.BASE_URL}icons8-goat-outline-16.png`;
const goatcounterEndpoint =
  import.meta.env.PUBLIC_GOATCOUNTER_ENDPOINT;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06101b" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" type="image/svg+xml" href={faviconPath} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700;800&family=Raleway:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>

  <body>
    <slot />

    <script
      data-goatcounter={goatcounterEndpoint}
      async
      src="https://gc.zgo.at/count.js"
    ></script>
  </body>
</html>
